<?xml version="1.0"?>
<robot name="ur5_rg2">
  <group name="ur5"><chain base_link="base_link" tip_link="rg2_hand"/></group>
  <group name="gripper">
    <joint name="rg2_finger_joint1"/>
    <joint name="rg2_finger_joint2"/>
  </group>
  <end_effector name="ur5_rg2_eef" parent_link="rg2_hand" group="gripper" parent_group="ur5"/>
  <group_state name="home" group="ur5">
    <joint name="shoulder_pan_joint" value="0"/>
    <joint name="shoulder_lift_joint" value="0"/>
    <joint name="elbow_joint" value="0"/>
    <joint name="wrist_1_joint" value="0"/>
    <joint name="wrist_2_joint" value="0"/>
    <joint name="wrist_3_joint" value="0"/>
  </group_state>
  <group_state name="home" group="gripper">
    <joint name="rg2_finger_joint1" value="0"/>
    <joint name="rg2_finger_joint2" value="0"/>
  </group_state>
  <!-- Joint-connected collision geometry; no sampled Never pairs are suppressed. -->
  <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_3_link" link2="rg2_hand" reason="Adjacent"/>
  <disable_collisions link1="rg2_hand" link2="rg2_leftfinger" reason="Adjacent"/>
  <disable_collisions link1="rg2_hand" link2="rg2_rightfinger" reason="Adjacent"/>
</robot>
